@{
    ViewData["Title"] = "Home";
}

<div class="hero text-center mb-4">
    <h1 class="fw-bold">Zaiqa Cooking Center</h1>
    <p class="lead mb-0">Biryani daig, korma &amp; zarda orders, prices and records in one place.</p>
</div>

<div class="row g-4">
    <div class="col-md-6 col-lg-3">
        <a href="/PriceSettings" class="text-decoration-none">
            <div class="card home-card h-100 text-center p-4">
                <div class="display-5">⚙️</div>
                <h5 class="mt-2 text-dark">Price Adjustment</h5>
                <p class="text-muted mb-0">Biryani, korma aur zarda ke rates set karein.</p>
            </div>
        </a>
    </div>
    <div class="col-md-6 col-lg-3">
        <a href="/Order" class="text-decoration-none">
            <div class="card home-card h-100 text-center p-4">
                <div class="display-5">🛒</div>
                <h5 class="mt-2 text-dark">New Order</h5>
                <p class="text-muted mb-0">Order ya aage ki date ki booking, receipt ke sath.</p>
            </div>
        </a>
    </div>
    <div class="col-md-6 col-lg-3">
        <a href="/PendingOrders" class="text-decoration-none">
            <div class="card home-card h-100 text-center p-4">
                <div class="display-5">⏳</div>
                <h5 class="mt-2 text-dark">Pending Orders</h5>
                <p class="text-muted mb-0">Aage ki date ke orders aur reminder.</p>
            </div>
        </a>
    </div>
    <div class="col-md-6 col-lg-3">
        <a href="/OrderList" class="text-decoration-none">
            <div class="card home-card h-100 text-center p-4">
                <div class="display-5">📋</div>
                <h5 class="mt-2 text-dark">Complete Orders</h5>
                <p class="text-muted mb-0">Saare orders, PDF download aur receipt print.</p>
            </div>
        </a>
    </div>
</div>
